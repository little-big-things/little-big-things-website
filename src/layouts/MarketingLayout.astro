---
import "../styles/lbt-colors.css";
import "../styles/lbt-page.css";

interface Props {
	title: string;
	description?: string;
	canonical?: string;
	image?: string;
	imageAlt?: string;
	noindex?: boolean;
}

const {
	title,
	description,
	canonical = "https://littlebigthings.co/",
	image = "https://littlebigthings.co/og-image.png",
	imageAlt = "Little Big Things: “the little things compound.”",
	noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="paper">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#190ADB" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preload" href="/fonts/soehne-halbfett.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/lora-latin-var.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/overused-grotesk-compound-var.woff2" as="font" type="font/woff2" crossorigin />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />
		{!noindex && <meta property="og:url" content={canonical} />}
		<meta property="og:site_name" content="Little Big Things" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={image} />
		<meta name="twitter:image:alt" content={imageAlt} />
	</head>
	<body class="lbh-baseline">
		<slot />
	</body>
</html>
