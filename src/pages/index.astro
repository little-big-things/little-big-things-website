---
import MarketingLayout from "../layouts/MarketingLayout.astro";
---

<MarketingLayout
	title="Little Big Things — Tim & Christina Frazer"
	description="Tim & Christina Frazer — a family of six (plus dog) from Pennsylvania, hosting the Little Big Humans podcast about raising small kids with the research that backs it."
	canonical="https://littlebigthings.co/"
>

  <!-- ===== NAV ===== -->
  <nav class="nav">
    <div class="container nav-inner">
      <a class="nav-mark" href="/" aria-label="Little Big Things — home">
        <svg class="lbt-mark" viewBox="0 0 160 140" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M10 120 L35 95 L60 120 Z"/>
          <path d="M40 120 L75 85 L110 120 Z"/>
          <path d="M80 120 L120 80 L160 120 Z"/>
          <rect x="0" y="124" width="160" height="6"/>
          <path class="notch" d="M78 118 L84 105 L78 105 L84 95 L78 108 L82 108 L74 118 Z"/>
        </svg>
        <span class="wm">Little Big Things<small>Tim &amp; Christina Frazer</small></span>
      </a>
      <div class="nav-links">
        <a href="#podcast">Podcast</a>
        <a href="#about">About</a>
        <a href="#work">Work</a>
        <a href="#contact">Contact</a>
      </div>
    </div>
  </nav>

  <!-- ===== HERO ===== -->
  <section class="hero" id="top">
    <div class="stripes" aria-hidden="true"></div>

    <div class="container hero-grid">
      <div>
        <h1 class="hero-headline">
          <span class="ln1">the little things</span>
          <span class="ln2"><em>compound.</em></span>
        </h1>

        <p class="hero-lede">
          Hi, we&rsquo;re <strong>Tim &amp; Christina Frazer</strong> &mdash; a family of six (plus dog) from Pennsylvania. We host a podcast about raising small kids, backed by the research we actually read. Pull up a chair.
        </p>

        <div class="hero-ctas">
          <a class="btn btn-primary btn-lg" href="https://littlebighumans.co" target="_blank" rel="noopener" style="color: rgb(255, 250, 248)">Listen to the podcast <span class="arrow">&rarr;</span></a>
          <a class="btn btn-ghost btn-lg" href="#about">About us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PODCAST ===== -->
  <section class="podcast" id="podcast">
    <div class="stripes" aria-hidden="true"></div>
    <div class="container podcast-grid">
      <div>
        <div class="eyebrow"><span class="bar"></span><span>The podcast</span></div>
        <h2>Little Big Humans &mdash; a podcast about raising small kids.</h2>
        <p>
          Every other week we sit down and talk through whatever we&rsquo;re currently figuring out as parents &mdash; sleep, illness, sibling dynamics &mdash; with the research that does (and doesn&rsquo;t) back it. Honest, hedged, citing studies, no hot takes.
        </p>
        <a class="podcast-cta" href="https://littlebighumans.co" target="_blank" rel="noopener">
          Listen at littlebighumans.co <span class="arrow">&rarr;</span>
        </a>
      </div>

      <aside class="podcast-meta">
        <div class="row"><span>Show</span><b>Little Big Humans</b></div>
        <div class="row"><span>Hosts</span><b>Tim &amp; Christina Frazer</b></div>
        <div class="row"><span>Cadence</span><b>Every other week</b></div>
        <div class="row"><span>Topics</span><b>Sleep &middot; feeding &middot; research</b></div>
        <div class="row"><span>Listen</span><b>Apple &middot; Spotify &middot; Substack</b></div>
      </aside>
    </div>
  </section>

  <!-- ===== ABOUT ===== -->
  <section id="about" style="background: color-mix(in srgb, var(--page-fg) 3%, var(--page-bg));">
    <div class="container">
      <div class="about-grid">
        <figure class="couple-photo">
          <img src="/assets/photo-christina.jpeg" alt="Tim & Christina Frazer" loading="eager" />
        </figure>

        <article class="about-intro">
          <h2 class="section-title" style="margin-bottom: 24px;">Hey, we&rsquo;re Tim &amp; Christina.</h2>
          <p>
            We live outside Philadelphia with our four kids and a dog who thinks she&rsquo;s the fifth. Tim works in data and AI engineering. Christina is a systems engineer and researcher. Between the two of us we&rsquo;ve spent almost twenty years building things for startups and companies like Amazon, Trust &amp; Will, and Thrive Global.
          </p>
          <p>
            But this site isn&rsquo;t really about that. It&rsquo;s about the podcast &mdash; <em>Little Big Humans</em> &mdash; where we talk about the stuff we&rsquo;re actually figuring out at home: how to get a toddler to sleep, what the research says about screen time, how to stay a team when you&rsquo;re outnumbered by small people. We read the papers so you don&rsquo;t have to, and we&rsquo;re honest about what we still don&rsquo;t know.
          </p>
          <p>
            If any of that sounds like your life right now, we&rsquo;d love to have you listening.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== WORK ===== -->
  <section class="work" id="work">
    <div class="container">
      <div class="work-grid">
        <div>
          <div class="eyebrow"><span class="bar"></span><span>The day jobs</span></div>
          <h2 class="section-title" style="margin-top: 14px;">We also build things for a living.</h2>
        </div>
        <div class="work-body">
          <p>
            Outside the podcast, Little Big Things is a small consulting and investing practice. Tim and Christina work across data, AI, and software engineering &mdash; usually with founders and technical leaders who need a focused extra set of hands, not an agency.
          </p>
          <p>
            We also invest small checks at pre-seed and seed. If either of those sounds relevant, reach out below &mdash; we&rsquo;re always happy to talk.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CONTACT ===== -->
  <section class="contact" id="contact">
    <div class="container contact-grid">
      <div>
        <div class="eyebrow"><span class="bar"></span><span>Get in touch</span></div>
        <h2 style="margin-top: 14px;">Say <em>hello.</em></h2>

        <form class="contact-form" id="contact-form">
          <div class="row">
            <div class="field"><input type="text" name="name" placeholder="Your name" required /></div>
            <div class="field"><input type="email" name="email" placeholder="Email" required /></div>
          </div>
          <div class="field">
            <textarea rows="3" name="message" placeholder="What's on your mind?"></textarea>
          </div>
          <div class="submit-row">
            <small>This opens a pre-filled email so your note is actually sent.</small>
            <button class="btn btn-primary btn-lg" type="submit">Send a message <span class="arrow">&rarr;</span></button>
          </div>
        </form>
      </div>

      <aside class="contact-aside">
        <div class="item">
          <div class="k">Email</div>
          <div class="v" style="font-size: 18px;"><a href="mailto:tim@littlebigthings.co">tim@littlebigthings.co</a></div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ===== FOOTER ===== -->
  <footer>
    <div class="container foot-grid">
      <div class="left">
        <svg class="lbt-mark" viewBox="0 0 160 140" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M10 120 L35 95 L60 120 Z"/>
          <path d="M40 120 L75 85 L110 120 Z"/>
          <path d="M80 120 L120 80 L160 120 Z"/>
          <rect x="0" y="124" width="160" height="6"/>
          <path class="notch" d="M78 118 L84 105 L78 105 L84 95 L78 108 L82 108 L74 118 Z"/>
        </svg>
        <span>Little Big Things</span>
      </div>
      <div class="right">&copy; 2026 Tim &amp; Christina Frazer</div>
    </div>
  </footer>

  <script>
    const contactForm = document.querySelector<HTMLFormElement>("#contact-form");
    contactForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      const data = new FormData(contactForm);
      const name = String(data.get("name") || "").trim();
      const email = String(data.get("email") || "").trim();
      const message = String(data.get("message") || "").trim();
      const status = contactForm.querySelector<HTMLElement>(".submit-row small");
      const button = contactForm.querySelector<HTMLButtonElement>("button[type='submit']");

      const subject = encodeURIComponent("Hello from " + name);
      const body = encodeURIComponent([
        `Name: ${name}`,
        `Email: ${email}`,
        "",
        message ? message : null,
      ].filter(Boolean).join("\n"));

      if (status) status.textContent = "Opening your email client\u2026";
      if (button) button.disabled = true;
      window.location.href = `mailto:tim@littlebigthings.co?subject=${subject}&body=${body}`;
    });
  </script>
</MarketingLayout>
