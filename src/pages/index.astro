---
import MarketingLayout from "../layouts/MarketingLayout.astro";
---

<MarketingLayout
	title="Little Big Things — Tim & Christina Frazer"
	description="Data, AI, and software engineering consulting for founders and technical leaders. Tim & Christina Frazer work end-to-end — from data architecture to production code."
	canonical="https://littlebigthings.co/"
>

  <!-- ===== NAV ===== -->
  <nav class="nav">
    <div class="container nav-inner">
      <a class="nav-mark" href="/" aria-label="Little Big Things — home">
        <svg class="lbt-mark" viewBox="0 0 160 140" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M10 120 L35 95 L60 120 Z"/>
          <path d="M40 120 L75 85 L110 120 Z"/>
          <path d="M80 120 L120 80 L160 120 Z"/>
          <rect x="0" y="124" width="160" height="6"/>
          <path class="notch" d="M78 118 L84 105 L78 105 L84 95 L78 108 L82 108 L74 118 Z"/>
        </svg>
        <span class="wm">Little Big Things<small>Tim &amp; Christina Frazer</small></span>
      </a>
      <div class="nav-links">
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </div>
    </div>
  </nav>

  <!-- ===== HERO ===== -->
  <section class="hero" id="top">
    <div class="stripes" aria-hidden="true"></div>

    <div class="container hero-grid">
      <div>
        <h1 class="hero-headline">
          <span class="ln1">the little things</span>
          <span class="ln2"><em>compound.</em></span>
        </h1>

        <p class="hero-lede">
          <strong>Little Big Things</strong> is a consulting and investing practice led by Tim &amp; Christina Frazer. We work end-to-end across data, AI, and software engineering &mdash; architecture through production code &mdash; for founders and technical leaders who need senior hands, not an agency.
        </p>

        <div class="hero-ctas">
          <a class="btn btn-primary btn-lg" href="#contact" style="color: rgb(255, 250, 248)">Get in touch <span class="arrow">&rarr;</span></a>
          <a class="btn btn-ghost btn-lg" href="#work">See our work</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== WORK ===== -->
  <section class="work" id="work">
    <div class="container">
      <div class="work-grid">
        <div>
          <div class="eyebrow"><span class="bar"></span><span>What we do</span></div>
          <h2 class="section-title" style="margin-top: 14px;">End-to-end data &amp; engineering for companies that ship.</h2>
        </div>
        <div class="work-body">
          <p>
            We embed with your team and own the problem from data strategy through working code. That means architecture, pipelines, infrastructure, and the software that ties it together &mdash; not a slide deck.
          </p>
          <p>
            Recent work includes end-to-end data architecture and development for <a href="https://molecularyou.com" target="_blank" rel="noopener">Molecular You</a> and <a href="https://joopiter.com" target="_blank" rel="noopener">Joopiter</a>, alongside longer relationships with teams at Amazon, Trust &amp; Will, Bonobos, and Thrive Global.
          </p>
          <p>
            We also invest at pre-seed and seed &mdash; typically in technical founders building in spaces we understand. If that&rsquo;s you, we&rsquo;d like to hear about it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ABOUT ===== -->
  <section id="about" style="background: color-mix(in srgb, var(--page-fg) 3%, var(--page-bg));">
    <div class="container">
      <div class="about-grid">
        <figure class="couple-photo">
          <img src="/assets/photo-christina.jpeg" alt="Tim & Christina Frazer" loading="eager" />
        </figure>

        <article class="about-intro">
          <h2 class="section-title" style="margin-bottom: 24px;">Tim &amp; Christina Frazer</h2>
          <p>
            Tim is a data and AI engineer who&rsquo;s spent the last fifteen years building analytics platforms, data infrastructure, and ML systems for startups and public companies. Christina is a systems engineer and researcher with deep experience in machine learning and scientific computing.
          </p>
          <p>
            We lead every engagement ourselves. We stay small on purpose &mdash; two people who know each other&rsquo;s work inside out, pulling in trusted collaborators when a project calls for more hands.
          </p>
          <p>
            We also host <a href="https://littlebighumans.co" target="_blank" rel="noopener"><em>Little Big Humans</em></a>, a podcast about raising young kids with the research that backs it. Four kids, one dog, Philadelphia.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== CONTACT ===== -->
  <section class="contact" id="contact">
    <div class="container contact-grid">
      <div>
        <div class="eyebrow"><span class="bar"></span><span>Get in touch</span></div>
        <h2 style="margin-top: 14px;">Tell us what you&rsquo;re <em>working on.</em></h2>

        <form class="contact-form" id="contact-form">
          <div class="row">
            <div class="field"><input type="text" name="name" placeholder="Your name" required /></div>
            <div class="field"><input type="email" name="email" placeholder="Email" required /></div>
          </div>
          <div class="field">
            <textarea rows="3" name="message" placeholder="What are you building? Where do you need help?"></textarea>
          </div>
          <div class="submit-row">
            <small>This opens a pre-filled email so your note is actually sent.</small>
            <button class="btn btn-primary btn-lg" type="submit">Send a message <span class="arrow">&rarr;</span></button>
          </div>
        </form>
      </div>

      <aside class="contact-aside">
        <div class="item">
          <div class="k">Email</div>
          <div class="v" style="font-size: 18px;"><a href="mailto:tim@littlebigthings.co">tim@littlebigthings.co</a></div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ===== FOOTER ===== -->
  <footer>
    <div class="container foot-grid">
      <div class="left">
        <svg class="lbt-mark" viewBox="0 0 160 140" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M10 120 L35 95 L60 120 Z"/>
          <path d="M40 120 L75 85 L110 120 Z"/>
          <path d="M80 120 L120 80 L160 120 Z"/>
          <rect x="0" y="124" width="160" height="6"/>
          <path class="notch" d="M78 118 L84 105 L78 105 L84 95 L78 108 L82 108 L74 118 Z"/>
        </svg>
        <span>Little Big Things</span>
      </div>
      <div class="right">&copy; 2026 Tim &amp; Christina Frazer</div>
    </div>
  </footer>

  <script>
    const contactForm = document.querySelector<HTMLFormElement>("#contact-form");
    contactForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      const data = new FormData(contactForm);
      const name = String(data.get("name") || "").trim();
      const email = String(data.get("email") || "").trim();
      const message = String(data.get("message") || "").trim();
      const status = contactForm.querySelector<HTMLElement>(".submit-row small");
      const button = contactForm.querySelector<HTMLButtonElement>("button[type='submit']");

      const subject = encodeURIComponent("Little Big Things — " + name);
      const body = encodeURIComponent([
        `Name: ${name}`,
        `Email: ${email}`,
        "",
        message ? message : null,
      ].filter(Boolean).join("\n"));

      if (status) status.textContent = "Opening your email client\u2026";
      if (button) button.disabled = true;
      window.location.href = `mailto:tim@littlebigthings.co?subject=${subject}&body=${body}`;
    });
  </script>
</MarketingLayout>
